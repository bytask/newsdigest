# ===========================================
# NewsDigest — 環境変数
# ===========================================
# 置き場所は 2 つ:
#   (A) Claude Code ルーティンの環境  … https://claude.ai/code/environments → 環境 → Environment variables
#       ルーティンはここから値を受け取る。これが本番。
#   (B) ローカル手動実行           … このファイルを .env / .env.local にコピー（gitignore 済み）
#
# Worker 側の secret（NEWSDIGEST_API_KEY = ブートストラップ鍵 / SESSION_SECRET / LINE_CHANNEL_*）は `wrangler secret put` で別途登録する
# （`npm run setup` が NEWSDIGEST_API_KEY と SESSION_SECRET を自動登録する）。
#
# API キーはスコープ付き（read / write / manage / admin）。コンソールの Settings 画面か `node scripts/post.mjs keys:add` で発行する。
#   (A) ルーティンの環境変数には  read,write  の鍵（`npm run setup` が "routine" として発行 → .env.local の NEWSDIGEST_ROUTINE_API_KEY）
#   (B) ローカルには              read,write,manage,admin の鍵（"local" として発行 → .env.local の NEWSDIGEST_API_KEY）

# --- 必須: コンソール API ---
NEWSDIGEST_API_URL=https://newsdigest.<your-subdomain>.workers.dev
NEWSDIGEST_API_KEY=<API キー: ルーティンなら routine 鍵、ローカルなら local 鍵>

# --- ローカルのみ（npm run setup が書く。ルーティンには不要） ---
# NEWSDIGEST_ROUTINE_API_KEY=<claude.ai の環境変数 NEWSDIGEST_API_KEY に貼る値>
# NEWSDIGEST_BOOTSTRAP_KEY=<Worker secret NEWSDIGEST_API_KEY と同じ値。復旧用>
# NEWSDIGEST_ADMIN_API_KEY=<任意。keys* / password:set で NEWSDIGEST_API_KEY の代わりに使う admin 鍵>

# --- 任意: X 収集（xAI x_search）。未設定なら X 系ソースをスキップし RSS/リリースのみで続行 ---
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4-1-fast

# --- 任意: ダイジェストの言語・タイムゾーン ---
# DIGEST_LANG=ja            # ja | en
# DIGEST_TZ=Asia/Tokyo      # 「昨日〜今日」の判定と日付ラベルに使う

# --- 任意: 通知（設定したものすべてに送る。未設定なら通知をスキップ） ---
# NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# NOTIFY_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# NOTIFY_WEBHOOK_URL=https://example.com/hook          # {"text": "..."} を POST
# LINE_CHANNEL_ID=                                     # LINE 公式アカウント（Messaging API）へ broadcast
# LINE_CHANNEL_SECRET=

# --- 任意: ダイジェスト Markdown をリポジトリにも commit する（既定 0 = しない） ---
# ルーティンの実行ブランチに digests/YYYY-MM-DD.md を commit/push する。アーカイブが欲しい場合のみ。
# DIGEST_COMMIT_LOGS=0
